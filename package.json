{
  "name": "freebench",
  "version": "0.0.1",
  "private": true,
  "description": "Live open-source leaderboard pairing verified free-tier LLM API availability with independent benchmarks.",
  "bin": {
    "freebench": "./bin/freebench.ts",
    "freebench-mcp": "./bin/freebench-mcp.ts"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "clean": "node -e \"require('node:fs').rmSync('.next',{recursive:true,force:true})\"",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync": "tsx scripts/sync.ts",
    "sync:dry": "tsx scripts/sync.ts --dry-run",
    "sync:providers": "tsx scripts/sync.ts --providers-only --dry-run",
    "cli": "tsx bin/freebench.ts",
    "mcp": "tsx bin/freebench-mcp.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "csv-parse": "^5.6.0",
    "fflate": "^0.8.2",
    "lucide-react": "^0.475.0",
    "next": "^15.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@tailwindcss/postcss": "^4.0.9",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.21.0",
    "eslint-config-next": "^15.3.3",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
